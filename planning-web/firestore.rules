rules_version = '2';

// Règles de sécurité du planning « Qui est où » · Circonscription de Koungou Nord.
// À copier dans : Console Firebase > Firestore Database > Règles > Publier.
//
// - Seules les personnes connectées avec une adresse @ac-mayotte.fr confirmée lisent le planning.
// - Chacun ne peut créer, modifier ou supprimer QUE son propre profil, SES créneaux et SES annonces.
// - Le motif exact d'une absence (ex. arrêt maladie) est rangé dans « prive » : lisible par la seule personne concernée.
// - Les activités et motifs créés sont partagés : tout membre peut en ajouter, personne ne peut les effacer.

service cloud.firestore {
  match /databases/{database}/documents {

    // Membre de l'équipe : compte connecté, adresse académique confirmée.
    function member() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower().matches('.*@ac-mayotte[.]fr$');
    }
    function isMe(uid) {
      return member() && request.auth.uid == uid;
    }
    function shortText(field, max) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string && request.resource.data[field].size() <= max);
    }

    // Profils : prénom, nom, fonction
    match /people/{uid} {
      allow read: if member();
      allow create, update: if isMe(uid)
        && request.resource.data.firstName is string && request.resource.data.firstName.size() <= 40
        && request.resource.data.lastName is string && request.resource.data.lastName.size() <= 40
        && request.resource.data.role is string && request.resource.data.role.size() <= 20
        && shortText('avatar', 8);
      allow delete: if isMe(uid);
    }

    // Créneaux : un planning par personne, visible par l'équipe
    match /planning/{uid}/shifts/{shiftId} {
      allow read: if member();
      allow create, update: if isMe(uid)
        && request.resource.data.uid == uid
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && request.resource.data.kind in ['shift', 'absence', 'dispo']
        && shortText('note', 140) && shortText('lieu', 80)
        && (!('with' in request.resource.data)
            || (request.resource.data.with is list && request.resource.data.with.size() <= 6));
      allow delete: if isMe(uid);
    }

    // Partie privée (motif exact et précision des absences, semaine type) : la personne seule
    match /planning/{uid}/prive/{docId} {
      allow read, delete: if isMe(uid);
      allow create, update: if isMe(uid) && shortText('absence', 40) && shortText('note', 140)
        && (!('items' in request.resource.data)
            || (request.resource.data.items is list && request.resource.data.items.size() <= 60));
    }

    // Annonces de l'équipe
    match /annonces/{id} {
      allow read: if member();
      allow create: if member()
        && request.resource.data.author == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() <= 280
        && request.resource.data.until is string && request.resource.data.until.size() == 10;
      allow delete: if member() && resource.data.author == request.auth.uid;
      allow update: if false;
    }

    // Activités et motifs d'absence ajoutés par l'équipe
    match /postes/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.name is string && request.resource.data.name.size() <= 40;
      allow update, delete: if false;
    }
    match /motifs/{id} {
      allow read: if member();
      allow create: if member() && request.resource.data.name is string && request.resource.data.name.size() <= 50;
      allow update, delete: if false;
    }
  }
}
